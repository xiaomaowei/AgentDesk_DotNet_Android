<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AgentDesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AgentDesk.ico" />
    <Content Include="Assets\AgentDesk.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentDesk.Core\AgentDesk.Core.csproj" />
    <ProjectReference Include="..\AgentDesk.Server\AgentDesk.Server.csproj" />
  </ItemGroup>

</Project>
